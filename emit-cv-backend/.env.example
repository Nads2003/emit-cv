# Copier en .env à la racine : cp .env.example .env   (ne JAMAIS committer le .env)
# Développement local sans Docker : cp .env.example .env
ENVIRONMENT=development
DATABASE_URL=sqlite:///./dev.db
CORS_ORIGINS=["http://localhost:5173"]
PUBLIC_URL=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
UPLOAD_DIR=./uploads
# e-mails : « console » affiche les liens de confirmation dans le terminal du backend
EMAIL_BACKEND=console
# file de tâches : « inline » (le serveur web traite tout seul) ou « worker » (lancer aussi : python -m app.worker)
TACHES_MODE=inline
AI_BACKEND=auto

# --- Obligatoires ---
POSTGRES_PASSWORD=changez-moi-mot-de-passe-long
# Générer : python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=generez-une-valeur-aleatoire-de-64-caracteres-minimum
# URL publique du site (CORS + liens des e-mails de confirmation)
PUBLIC_ORIGIN=http://localhost:8080
# true dès que le site est servi en HTTPS (cookie sécurisé + HSTS)
COOKIE_SECURE=false


# --- E-mail (vérification des inscriptions) : « smtp » en production ; « console » écrit les e-mails dans les journaux (essais) ---
EMAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=EMIT CV <no-reply@votre-domaine.mg>

# --- HTTPS automatique (docker-compose.prod.yml) ---
DOMAINE=cv.votre-domaine.mg
# --- Réglages ---
HTTP_PORT=8080
WEB_CONCURRENCY=3
